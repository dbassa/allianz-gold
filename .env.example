# Resend — email delivery for the contact form
# Get an API key at https://resend.com (free up to 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Recipient mailbox (the email that receives form submissions)
CONTACT_TO=corporate@allianzgold.com

# Sender — while the domain is not yet verified in Resend, use the sandbox value below.
# Once allianzgold.com is verified, switch this to e.g. "Allianz Gold <noreply@allianzgold.com>".
CONTACT_FROM=onboarding@resend.dev

# Public site URL — used for email links and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
